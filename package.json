{
  "name": "next-hakoniwa",
  "type": "module",
  "version": "0.10.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "24.14.1",
    "npm": "11.11.0"
  },
  "scripts": {
    "lefthook": "npx lefthook install",
    "dev": "next dev",
    "build": "next build",
    "build:mini": "NODE_OPTIONS=--max-old-space-size=2048 NEXT_BUILD_CPUS=2 next build",
    "build:docker": "if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then docker compose run --rm app-build; elif command -v docker-compose >/dev/null 2>&1 && [ -x \"$(command -v docker-compose)\" ]; then docker-compose run --rm app-build; else echo 'Docker Compose is not available'; exit 1; fi",
    "start": "next start",
    "test": "vitest",
    "turn": "tsx ./src/db/turn.ts",
    "lint": "eslint 'src/**/*.{ts,tsx}' && npm run lint:style && npm run lint:type",
    "lint:style": "stylelint --ignore-path .gitignore 'src/**/*.(css|tsx)'",
    "lint:type": "tsc --noEmit --incremental false",
    "fmt": "prettier --write **/*.{css,scss,json,md,ts,tsx}",
    "fmt-check": "prettier --check **/*.{css,scss,json,md}",
    "ncu:upd": "npx -y npm-check-updates -u",
    "db:codegen": "tsx ./src/db/codegen.ts",
    "db:init": "tsx ./src/db/migrate.ts && npm run db:codegen",
    "db:migrate": "tsx ./src/db/migrate.ts && npm run db:codegen",
    "db:rollback": "tsx ./src/db/migrate.ts down",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pentest": "./scripts/pentest.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@formkit/auto-animate": "0.9.0",
    "@hookform/resolvers": "5.2.2",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.0",
    "@tailwindcss/postcss": "4.3.0",
    "argon2": "0.44.0",
    "better-sqlite3": "12.10.0",
    "croner": "10.0.1",
    "dotenv-flow": "4.1.0",
    "html-react-parser": "6.1.1",
    "jsonwebtoken": "9.0.3",
    "kysely": "0.29.2",
    "mysql2": "3.22.3",
    "next": "16.2.6",
    "next-mdx-remote-client": "2.1.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.76.0",
    "react-icons": "5.6.0",
    "react-virtuoso": "4.18.7",
    "tsx": "4.22.1",
    "typescript": "6.0.3",
    "uuidv7": "1.2.1",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.2.1",
    "@evilmartians/lefthook": "2.1.6",
    "@storybook/addon-docs": "10.4.0",
    "@storybook/addon-onboarding": "10.4.0",
    "@storybook/nextjs": "10.4.0",
    "@swc/helpers": "0.5.21",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitejs/plugin-react": "6.0.2",
    "baseline-browser-mapping": "2.10.30",
    "eslint": "9.39.3",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-next-router-async": "1.0.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-storybook": "10.4.0",
    "eslint-plugin-tailwindcss": "4.0.4",
    "happy-dom": "20.9.0",
    "kysely-codegen": "0.20.0",
    "postcss": "8.5.14",
    "postcss-styled-syntax": "0.7.1",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.8.0",
    "sass": "1.99.0",
    "storybook": "10.4.0",
    "stylelint": "17.11.1",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-prettier": "5.0.3",
    "tailwindcss": "4.3.0",
    "terser-webpack-plugin": "5.6.0",
    "typedoc": "0.28.19",
    "vitest": "4.1.6"
  }
}
